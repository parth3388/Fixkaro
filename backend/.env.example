# Copy this file to .env and fill in real values. Never commit .env.

ENVIRONMENT=development

# PostgreSQL connection string.
# Local/dev (matches docker-compose.yml, which maps Postgres to host port
# 5433 to avoid clashing with a locally-installed PostgreSQL on 5432):
DATABASE_URL=postgresql+psycopg2://fixkar:fixkar@localhost:5433/fixkar

# Comma-separated list of frontend origins allowed to call this API.
# Local dev (VS Code Live Server default ports):
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
# Production example:
# CORS_ORIGINS=https://fix-kar.in,https://www.fix-kar.in

# Reserved for future signed tokens (e.g. admin auth). Generate a long random
# value for production, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production
